; Installer strings: English, Georgian, Russian. UTF-8.

LangString LangCode ${LANG_ENGLISH} "en"
LangString LangCode ${LANG_GEORGIAN} "ka"
LangString LangCode ${LANG_RUSSIAN} "ru"

LangString WelcomeTitle ${LANG_ENGLISH} "Make this PC safer for your child"
LangString WelcomeTitle ${LANG_GEORGIAN} "გახადეთ ეს კომპიუტერი ბავშვისთვის უფრო უსაფრთხო"
LangString WelcomeTitle ${LANG_RUSSIAN} "Сделайте этот компьютер безопаснее для ребёнка"

; The welcome text says whether the extension is in the stores yet (tools/build-installer.sh
; defines EXT_IN_STORES when shared/ext-ids.json has a store id).
!ifdef EXT_IN_STORES
LangString WelcomeText ${LANG_ENGLISH} "${APP_NAME} protects the Windows account your child uses: safe search, a family DNS filter, no private windows and daily time limits for the child's age.$\r$\n$\r$\nThe browser extension (time limits, ad blocker, YouTube without the feed, page check) installs from the browser stores; the parent page shows whether it is active in each browser.$\r$\n$\r$\nIt protects web browsers only (Chrome, Edge, Brave, Firefox); other browsers are closed in your child's account. Games, chat and other apps are not covered.$\r$\n$\r$\nNo filter is perfect: stay close and talk with your child. The child needs a standard Windows account; an administrator can remove this protection. Your PIN is needed to change the settings and to remove ${APP_NAME}."
LangString WelcomeText ${LANG_GEORGIAN} "${APP_NAME} იცავს Windows-ის იმ ანგარიშს, რომელსაც ბავშვი იყენებს: უსაფრთხო ძიება, საოჯახო DNS-ფილტრი, პირადი ფანჯრების აკრძალვა და დღიური ლიმიტი ბავშვის ასაკის მიხედვით.$\r$\n$\r$\nბრაუზერის გაფართოება (დროის ლიმიტები, რეკლამის ბლოკერი, YouTube ლენტის გარეშე, გვერდის შემოწმება) ბრაუზერების მაღაზიებიდან დაყენდება; მშობლის გვერდზე ჩანს, აქტიურია თუ არა ის თითოეულ ბრაუზერში.$\r$\n$\r$\nიცავს მხოლოდ ვებბრაუზერებს (Chrome, Edge, Brave, Firefox); სხვა ბრაუზერები თქვენი შვილის ანგარიშში იხურება. თამაშებს, ჩატებსა და სხვა პროგრამებს არ იცავს.$\r$\n$\r$\nარცერთი ფილტრი არ არის სრულყოფილი: იყავით ახლოს და ესაუბრეთ ბავშვს. ბავშვს სჭირდება Windows-ის სტანდარტული ანგარიში; ადმინისტრატორს შეუძლია ამ დაცვის მოხსნა. PIN-კოდი დაგჭირდებათ პარამეტრების შესაცვლელად და ${APP_NAME}-ის წასაშლელად."
LangString WelcomeText ${LANG_RUSSIAN} "${APP_NAME} защищает учётную запись Windows, которой пользуется ребёнок: безопасный поиск, семейный DNS-фильтр, запрет приватных окон и дневной лимит времени по возрасту ребёнка.$\r$\n$\r$\nРасширение для браузера (лимиты времени, блокировщик рекламы, YouTube без ленты, проверка страниц) устанавливается из магазинов браузеров; на странице родителя видно, работает ли оно в каждом браузере.$\r$\n$\r$\nЗащищает только веб-браузеры (Chrome, Edge, Brave, Firefox); другие браузеры закрываются в учётной записи ребёнка. На игры, чаты и другие программы защита не распространяется.$\r$\n$\r$\nНи один фильтр не идеален: будьте рядом и говорите с ребёнком. Ребёнку нужна стандартная учётная запись Windows; администратор может снять эту защиту. PIN-код нужен, чтобы менять настройки и удалить ${APP_NAME}."
!else
LangString WelcomeText ${LANG_ENGLISH} "${APP_NAME} protects the Windows account your child uses: safe search, a family DNS filter and no private windows.$\r$\n$\r$\nThe browser extension (time limits, ad blocker, YouTube without the feed) will install from the browser stores once it is published there; until then only these settings are set.$\r$\n$\r$\nIt protects web browsers only (Chrome, Edge, Brave, Firefox); other browsers are closed in your child's account. Games, chat and other apps are not covered.$\r$\n$\r$\nNo filter is perfect: stay close and talk with your child. The child needs a standard Windows account; an administrator can remove this protection. Your PIN is needed to change the settings and to remove ${APP_NAME}."
LangString WelcomeText ${LANG_GEORGIAN} "${APP_NAME} იცავს Windows-ის იმ ანგარიშს, რომელსაც ბავშვი იყენებს: უსაფრთხო ძიება, საოჯახო DNS-ფილტრი და პირადი ფანჯრების აკრძალვა.$\r$\n$\r$\nბრაუზერის გაფართოება (დროის ლიმიტები, რეკლამის ბლოკერი, YouTube ლენტის გარეშე) ბრაუზერების მაღაზიებიდან დაყენდება, როცა იქ გამოქვეყნდება; მანამდე მხოლოდ ეს პარამეტრები დაყენდება.$\r$\n$\r$\nიცავს მხოლოდ ვებბრაუზერებს (Chrome, Edge, Brave, Firefox); სხვა ბრაუზერები თქვენი შვილის ანგარიშში იხურება. თამაშებს, ჩატებსა და სხვა პროგრამებს არ იცავს.$\r$\n$\r$\nარცერთი ფილტრი არ არის სრულყოფილი: იყავით ახლოს და ესაუბრეთ ბავშვს. ბავშვს სჭირდება Windows-ის სტანდარტული ანგარიში; ადმინისტრატორს შეუძლია ამ დაცვის მოხსნა. PIN-კოდი დაგჭირდებათ პარამეტრების შესაცვლელად და ${APP_NAME}-ის წასაშლელად."
LangString WelcomeText ${LANG_RUSSIAN} "${APP_NAME} защищает учётную запись Windows, которой пользуется ребёнок: безопасный поиск, семейный DNS-фильтр и запрет приватных окон.$\r$\n$\r$\nРасширение для браузера (лимиты времени, блокировщик рекламы, YouTube без ленты) будет устанавливаться из магазинов браузеров, когда его там опубликуют; до тех пор задаются только эти настройки.$\r$\n$\r$\nЗащищает только веб-браузеры (Chrome, Edge, Brave, Firefox); другие браузеры закрываются в учётной записи ребёнка. На игры, чаты и другие программы защита не распространяется.$\r$\n$\r$\nНи один фильтр не идеален: будьте рядом и говорите с ребёнком. Ребёнку нужна стандартная учётная запись Windows; администратор может снять эту защиту. PIN-код нужен, чтобы менять настройки и удалить ${APP_NAME}."
!endif

LangString AccTitle ${LANG_ENGLISH} "Which accounts to protect"
LangString AccTitle ${LANG_GEORGIAN} "რომელი ანგარიშები დავიცვათ"
LangString AccTitle ${LANG_RUSSIAN} "Какие учётные записи защитить"
LangString AccSub ${LANG_ENGLISH} "Choose the Windows accounts your child uses."
LangString AccSub ${LANG_GEORGIAN} "აირჩიეთ Windows-ის ანგარიშები, რომლებსაც ბავშვი იყენებს."
LangString AccSub ${LANG_RUSSIAN} "Выберите учётные записи Windows, которыми пользуется ребёнок."
LangString AccIntro ${LANG_ENGLISH} "Filters and time limits apply only to the accounts you tick. Your own account stays as it is."
LangString AccIntro ${LANG_GEORGIAN} "ფილტრები და დროის ლიმიტი მოქმედებს მხოლოდ მონიშნულ ანგარიშებზე. თქვენი ანგარიში უცვლელი რჩება."
LangString AccIntro ${LANG_RUSSIAN} "Фильтры и ограничения времени действуют только на отмеченные учётные записи. Ваша учётная запись не меняется."
LangString AdminSuffix ${LANG_ENGLISH} " (administrator: can remove the protection)"
LangString AdminSuffix ${LANG_GEORGIAN} " (ადმინისტრატორი: შეუძლია დაცვის მოხსნა)"
LangString AdminSuffix ${LANG_RUSSIAN} " (администратор: может снять защиту)"
LangString NoStandard ${LANG_ENGLISH} "There is no standard account on this PC yet. Best: create one for your child in Windows Settings, Accounts, Other users, then run this setup again."
LangString NoStandard ${LANG_GEORGIAN} "ამ კომპიუტერზე სტანდარტული ანგარიში ჯერ არ არის. საუკეთესოა, შექმნათ ის ბავშვისთვის: Windows-ის პარამეტრები, ანგარიშები, სხვა მომხმარებლები, შემდეგ კი თავიდან გაუშვათ ეს პროგრამა."
LangString NoStandard ${LANG_RUSSIAN} "На этом компьютере пока нет стандартной учётной записи. Лучше создать её для ребёнка: Параметры Windows, Учётные записи, Другие пользователи, а затем снова запустить установку."
LangString Everyone ${LANG_ENGLISH} "Everyone on this PC: only if the child has no own account. The limits then apply to you too."
LangString Everyone ${LANG_GEORGIAN} "ამ კომპიუტერის ყველა მომხმარებელი: მხოლოდ მაშინ, თუ ბავშვს საკუთარი ანგარიში არ აქვს. ლიმიტი თქვენზეც იმოქმედებს."
LangString Everyone ${LANG_RUSSIAN} "Все пользователи этого компьютера: только если у ребёнка нет своей учётной записи. Ограничения будут действовать и на вас."
LangString NeedAccount ${LANG_ENGLISH} "Please tick at least one account."
LangString NeedAccount ${LANG_GEORGIAN} "გთხოვთ, მონიშნოთ ერთი ანგარიში მაინც."
LangString NeedAccount ${LANG_RUSSIAN} "Отметьте хотя бы одну учётную запись."

LangString AgeTitle ${LANG_ENGLISH} "Age and PIN"
LangString AgeTitle ${LANG_GEORGIAN} "ასაკი და PIN-კოდი"
LangString AgeTitle ${LANG_RUSSIAN} "Возраст и PIN-код"
LangString AgeSub ${LANG_ENGLISH} "The age sets the filters and the recommended daily time."
LangString AgeSub ${LANG_GEORGIAN} "ასაკის მიხედვით დგინდება ფილტრები და რეკომენდებული დღიური დრო."
LangString AgeSub ${LANG_RUSSIAN} "По возрасту задаются фильтры и рекомендуемое время в день."
LangString AgeLabel ${LANG_ENGLISH} "Child's age"
LangString AgeLabel ${LANG_GEORGIAN} "ბავშვის ასაკი"
LangString AgeLabel ${LANG_RUSSIAN} "Возраст ребёнка"
LangString Band35 ${LANG_ENGLISH} "3 to 5 years"
LangString Band35 ${LANG_GEORGIAN} "3-დან 5 წლამდე"
LangString Band35 ${LANG_RUSSIAN} "От 3 до 5 лет"
LangString Band68 ${LANG_ENGLISH} "6 to 8 years"
LangString Band68 ${LANG_GEORGIAN} "6-დან 8 წლამდე"
LangString Band68 ${LANG_RUSSIAN} "От 6 до 8 лет"
LangString Band912 ${LANG_ENGLISH} "9 to 12 years"
LangString Band912 ${LANG_GEORGIAN} "9-დან 12 წლამდე"
LangString Band912 ${LANG_RUSSIAN} "От 9 до 12 лет"
LangString Band1315 ${LANG_ENGLISH} "13 to 15 years"
LangString Band1315 ${LANG_GEORGIAN} "13-დან 15 წლამდე"
LangString Band1315 ${LANG_RUSSIAN} "От 13 до 15 лет"
LangString Band1617 ${LANG_ENGLISH} "16 to 17 years"
LangString Band1617 ${LANG_GEORGIAN} "16-დან 17 წლამდე"
LangString Band1617 ${LANG_RUSSIAN} "От 16 до 17 лет"
LangString PinLabel ${LANG_ENGLISH} "Parent PIN, 4 to 8 digits"
LangString PinLabel ${LANG_GEORGIAN} "მშობლის PIN-კოდი, 4-დან 8 ციფრამდე"
LangString PinLabel ${LANG_RUSSIAN} "PIN-код родителя, от 4 до 8 цифр"
LangString PinLabelShort ${LANG_ENGLISH} "Parent PIN"
LangString PinLabelShort ${LANG_GEORGIAN} "მშობლის PIN-კოდი"
LangString PinLabelShort ${LANG_RUSSIAN} "PIN-код родителя"
LangString Pin2Label ${LANG_ENGLISH} "PIN again"
LangString Pin2Label ${LANG_GEORGIAN} "გაიმეორეთ PIN-კოდი"
LangString Pin2Label ${LANG_RUSSIAN} "Повторите PIN-код"
LangString PinHint ${LANG_ENGLISH} "You need the PIN to change the settings and to remove the protection. Keep it to yourself."
LangString PinHint ${LANG_GEORGIAN} "PIN-კოდი დაგჭირდებათ პარამეტრების შესაცვლელად და დაცვის მოსახსნელად. არავის უთხრათ."
LangString PinHint ${LANG_RUSSIAN} "PIN-код нужен, чтобы менять настройки и снять защиту. Никому его не говорите."
LangString UpgradeNote ${LANG_ENGLISH} "${APP_NAME} is already installed: enter the PIN you set before. Your settings are kept; the age chosen here is used only for newly added accounts."
LangString UpgradeNote ${LANG_GEORGIAN} "${APP_NAME} უკვე დაყენებულია: შეიყვანეთ ადრე დაყენებული PIN-კოდი. თქვენი პარამეტრები შენარჩუნდება; აქ არჩეული ასაკი მხოლოდ ახლად დამატებულ ანგარიშებზე გავრცელდება."
LangString UpgradeNote ${LANG_RUSSIAN} "${APP_NAME} уже установлен: введите PIN-код, который вы задали раньше. Ваши настройки сохранятся; выбранный здесь возраст применится только к новым учётным записям."
LangString PinBad ${LANG_ENGLISH} "The PIN must be 4 to 8 digits, and both must be the same."
LangString PinBad ${LANG_GEORGIAN} "PIN-კოდი უნდა შედგებოდეს 4-8 ციფრისგან და ორივე ერთნაირი უნდა იყოს."
LangString PinBad ${LANG_RUSSIAN} "PIN-код должен состоять из 4–8 цифр, и оба должны совпадать."
LangString UpgradeWrongPin ${LANG_ENGLISH} "${APP_NAME} is already installed with another PIN. Please enter the PIN you set before."
LangString UpgradeWrongPin ${LANG_GEORGIAN} "${APP_NAME} უკვე დაყენებულია სხვა PIN-კოდით. გთხოვთ, შეიყვანოთ ადრე დაყენებული PIN-კოდი."
LangString UpgradeWrongPin ${LANG_RUSSIAN} "${APP_NAME} уже установлен с другим PIN-кодом. Введите PIN-код, который вы задали раньше."

LangString Applying ${LANG_ENGLISH} "Setting up the browsers..."
LangString Applying ${LANG_GEORGIAN} "ბრაუზერების მორგება..."
LangString Applying ${LANG_RUSSIAN} "Настройка браузеров..."
LangString InstallFailed ${LANG_ENGLISH} "Setup could not finish. Please run it again."
LangString InstallFailed ${LANG_GEORGIAN} "ინსტალაცია ვერ დასრულდა. გთხოვთ, თავიდან გაუშვათ."
LangString InstallFailed ${LANG_RUSSIAN} "Установка не завершилась. Запустите её ещё раз."
LangString NeedsWin64 ${LANG_ENGLISH} "${APP_NAME} needs 64-bit Windows 10 or 11."
LangString NeedsWin64 ${LANG_GEORGIAN} "${APP_NAME}-ს სჭირდება 64-ბიტიანი Windows 10 ან 11."
LangString NeedsWin64 ${LANG_RUSSIAN} "Для ${APP_NAME} нужна 64-разрядная Windows 10 или 11."
LangString Locked ${LANG_ENGLISH} "Too many wrong tries. Please wait 15 minutes and try again."
LangString Locked ${LANG_GEORGIAN} "ძალიან ბევრი არასწორი ცდა. მოიცადეთ 15 წუთი და სცადეთ თავიდან."
LangString Locked ${LANG_RUSSIAN} "Слишком много неверных попыток. Подождите 15 минут и попробуйте снова."

LangString FinishTitle ${LANG_ENGLISH} "${APP_NAME} is ready"
LangString FinishTitle ${LANG_GEORGIAN} "${APP_NAME} მზადაა"
LangString FinishTitle ${LANG_RUSSIAN} "${APP_NAME} готов"
LangString FinishText ${LANG_ENGLISH} "The protected accounts get the settings at their next sign-in, or within 5 minutes if they are signed in now.$\r$\n$\r$\nTo change the limits or see the 7-day report, open $\"Parent settings$\" in the Start menu."
LangString FinishText ${LANG_GEORGIAN} "დაცული ანგარიშები პარამეტრებს მიიღებენ შემდეგი შესვლისას, ან 5 წუთში, თუ ახლა შესულები არიან.$\r$\n$\r$\nლიმიტის შესაცვლელად ან 7 დღის ანგარიშის სანახავად გახსენით $\"მშობლის პარამეტრები$\" Start-მენიუში."
LangString FinishText ${LANG_RUSSIAN} "Защищённые учётные записи получат настройки при следующем входе или в течение 5 минут, если в них уже выполнен вход.$\r$\n$\r$\nЧтобы изменить ограничения или посмотреть отчёт за 7 дней, откройте $\"Настройки для родителей$\" в меню «Пуск»."
LangString ShortcutName ${LANG_ENGLISH} "Parent settings"
LangString ShortcutName ${LANG_GEORGIAN} "მშობლის პარამეტრები"
LangString ShortcutName ${LANG_RUSSIAN} "Настройки для родителей"

LangString UnTitle ${LANG_ENGLISH} "Remove ${APP_NAME}"
LangString UnTitle ${LANG_GEORGIAN} "${APP_NAME}-ის წაშლა"
LangString UnTitle ${LANG_RUSSIAN} "Удаление ${APP_NAME}"
LangString UnSub ${LANG_ENGLISH} "The parent PIN is needed."
LangString UnSub ${LANG_GEORGIAN} "საჭიროა მშობლის PIN-კოდი."
LangString UnSub ${LANG_RUSSIAN} "Нужен PIN-код родителя."
LangString UnIntro ${LANG_ENGLISH} "This removes the protection, the browser settings it made and the service. Usage reports are deleted too."
LangString UnIntro ${LANG_GEORGIAN} "ეს მოხსნის დაცვას, მის მიერ ბრაუზერებში შეტანილ ცვლილებებს და სერვისს. ასევე წაიშლება გამოყენების ანგარიშები."
LangString UnIntro ${LANG_RUSSIAN} "Будут удалены защита, сделанные ею настройки браузеров и служба. Отчёты об использовании тоже удалятся."
LangString UnWrong ${LANG_ENGLISH} "That PIN is not right."
LangString UnWrong ${LANG_GEORGIAN} "PIN-კოდი არასწორია."
LangString UnWrong ${LANG_RUSSIAN} "Неверный PIN-код."
LangString Removing ${LANG_ENGLISH} "Removing the browser settings..."
LangString Removing ${LANG_GEORGIAN} "ბრაუზერის პარამეტრების წაშლა..."
LangString Removing ${LANG_RUSSIAN} "Удаление настроек браузеров..."
LangString UnFailed ${LANG_ENGLISH} "Some settings could not be removed. Please run the uninstaller again."
LangString UnFailed ${LANG_GEORGIAN} "ზოგიერთი პარამეტრის წაშლა ვერ მოხერხდა. გთხოვთ, თავიდან გაუშვათ წაშლის პროგრამა."
LangString UnFailed ${LANG_RUSSIAN} "Не все настройки удалось удалить. Запустите удаление ещё раз."

LangString DnsTitle ${LANG_ENGLISH} "Family DNS filter"
LangString DnsTitle ${LANG_GEORGIAN} "საოჯახო DNS-ფილტრი"
LangString DnsTitle ${LANG_RUSSIAN} "Семейный DNS-фильтр"
LangString DnsSub ${LANG_ENGLISH} "Choose whether AdGuard DNS checks the sites your child opens."
LangString DnsSub ${LANG_GEORGIAN} "აირჩიეთ, შეამოწმოს თუ არა AdGuard DNS-მა თქვენი შვილის მიერ გახსნილი საიტები."
LangString DnsSub ${LANG_RUSSIAN} "Выберите, будет ли AdGuard DNS проверять сайты, которые открывает ребёнок."
LangString DnsCheck ${LANG_ENGLISH} "Use the AdGuard DNS Family filter (recommended)"
LangString DnsCheck ${LANG_GEORGIAN} "AdGuard DNS Family-ის ფილტრის გამოყენება (რეკომენდებულია)"
LangString DnsCheck ${LANG_RUSSIAN} "Использовать фильтр AdGuard DNS Family (рекомендуется)"
LangString DnsText ${LANG_ENGLISH} "It blocks adult sites, phishing and many ads in your child's browsers, and turns on safe search.$\r$\n$\r$\nAdGuard DNS, a free public service, then sees the names of the sites your child opens (not the pages or what is typed) and your internet address, as any DNS service does. If it cannot be reached, sites do not open until it is back or you switch it off.$\r$\n$\r$\nClear the box to use your internet provider's usual DNS; the extension's own block lists still work.$\r$\n$\r$\nThe new tab page also shows videos from chosen YouTube channels, loaded from YouTube (Focus mode). You can change both on the parent page. Nothing is sent to us."
LangString DnsText ${LANG_GEORGIAN} "ის ბლოკავს ზრდასრულთა საიტებს, ფიშინგს და რეკლამის დიდ ნაწილს თქვენი შვილის ბრაუზერებში და ჩართავს უსაფრთხო ძიებას.$\r$\n$\r$\nAdGuard DNS, უფასო საჯარო სერვისი, ხედავს იმ საიტების სახელებს, რომლებსაც ბავშვი ხსნის (არა გვერდებს ან აკრეფილ ტექსტს), და თქვენს ინტერნეტ-მისამართს, როგორც ნებისმიერი DNS-სერვისი. თუ ის მიუწვდომელია, საიტები არ გაიხსნება, სანამ ის არ აღდგება ან თქვენ არ გამორთავთ ფილტრს.$\r$\n$\r$\nმონიშვნა მოხსენით, თუ გსურთ ინტერნეტპროვაიდერის ჩვეულებრივი DNS-ის გამოყენება; გაფართოების საკუთარი ბლოკირების სიები მაინც იმუშავებს.$\r$\n$\r$\nახალი ჩანართის გვერდზე ასევე ჩანს შერჩეული YouTube-არხების ვიდეოები, რომლებიც YouTube-იდან იტვირთება (ფოკუსის რეჟიმი). ორივეს შეცვლა მშობლის გვერდზე შეგიძლიათ. ჩვენთან არაფერი იგზავნება."
LangString DnsText ${LANG_RUSSIAN} "Он блокирует сайты для взрослых, фишинг и много рекламы в браузерах ребёнка и включает безопасный поиск.$\r$\n$\r$\nAdGuard DNS, бесплатный публичный сервис, видит названия сайтов, которые открывает ребёнок (но не страницы и не то, что набрано), и ваш интернет-адрес, как любой DNS-сервис. Если он недоступен, сайты не откроются, пока он не заработает или вы не выключите фильтр.$\r$\n$\r$\nСнимите галочку, чтобы пользоваться обычным DNS интернет-провайдера; собственные списки блокировки расширения продолжат работать.$\r$\n$\r$\nНа странице новой вкладки также показываются видео выбранных каналов YouTube, которые загружаются с YouTube (режим фокуса). Оба параметра можно изменить на странице для родителей. К нам ничего не отправляется."
