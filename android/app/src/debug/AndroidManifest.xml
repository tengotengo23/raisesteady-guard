<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: test hooks for the e2e tests (settings and filter start, the child screens, clock offset, status).
     The two activities have their own task affinity: in Guard's task (where MainActivity may be) a second
     start only brought that task to the front and never ran them (run 41941490605, "result code=2"). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <activity
            android:name=".debug.DebugFilterActivity"
            android:excludeFromRecents="true"
            android:taskAffinity="com.raisesteady.guard.debug"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay" />
        <activity
            android:name=".debug.DebugShowActivity"
            android:excludeFromRecents="true"
            android:taskAffinity="com.raisesteady.guard.debug"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay" />
        <receiver
            android:name=".debug.DebugClockReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver" />
        <receiver
            android:name=".debug.DebugStatusReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver" />
    </application>
</manifest>
