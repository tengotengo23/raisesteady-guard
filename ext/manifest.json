{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "__MSG_extShortName__",
  "description": "__MSG_extDesc__",
  "version": "0.2.2",
  "key": "",
  "default_locale": "en",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background/main.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "webNavigation",
    "alarms",
    "notifications",
    "idle"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "pages/popup.html",
    "default_title": "__MSG_extName__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "pages/options.html",
    "open_in_tab": true
  },
  "chrome_url_overrides": {
    "newtab": "pages/newtab.html"
  },
  "storage": {
    "managed_schema": "managed_schema.json"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/classify.js",
        "content/page-check.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/cosmetic.js"
      ],
      "css": [
        "rules/cosmetic.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://youtube.com/*"
      ],
      "js": [
        "content/focus-youtube.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://youtube.com/*"
      ],
      "js": [
        "content/yt-ads-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.tiktok.com/*",
        "*://*.instagram.com/*",
        "*://*.facebook.com/*",
        "*://*.x.com/*",
        "*://*.twitter.com/*",
        "*://*.reddit.com/*",
        "*://*.snapchat.com/*",
        "*://*.pinterest.com/*",
        "*://*.threads.net/*",
        "*://*.threads.com/*",
        "*://*.vk.com/*",
        "*://*.ok.ru/*",
        "*://*.tumblr.com/*"
      ],
      "js": [
        "content/focus-social.js"
      ],
      "run_at": "document_start"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "adult",
        "enabled": true,
        "path": "rules/adult.json"
      },
      {
        "id": "gambling",
        "enabled": true,
        "path": "rules/gambling.json"
      },
      {
        "id": "bypass",
        "enabled": true,
        "path": "rules/bypass.json"
      },
      {
        "id": "social",
        "enabled": true,
        "path": "rules/social.json"
      },
      {
        "id": "ads",
        "enabled": true,
        "path": "rules/ads.json"
      },
      {
        "id": "yt_ads",
        "enabled": true,
        "path": "rules/yt-ads.json"
      },
      {
        "id": "safesearch",
        "enabled": true,
        "path": "rules/safesearch.json"
      },
      {
        "id": "yt_strict",
        "enabled": true,
        "path": "rules/yt-strict.json"
      },
      {
        "id": "yt_moderate",
        "enabled": false,
        "path": "rules/yt-moderate.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "pages/blocked.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
